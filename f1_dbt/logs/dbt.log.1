[0m12:27:21.915736 [debug] [Thread-4 (]: On model.f1_dbt.fact_driver_titles_ranked: /* {"app": "dbt", "dbt_version": "1.9.0", "profile_name": "f1_dbt", "target_name": "dev", "node_id": "model.f1_dbt.fact_driver_titles_ranked"} */

  
    

  create  table "f1_raw"."dbt_analytics"."fact_driver_titles_ranked__dbt_tmp"
  
  
    as
  
  (
    WITH driver_titles AS (
    SELECT
        driver_id,
        COUNT(*) AS total_driver_titles
    FROM "f1_raw"."dbt_analytics"."fact_championships"
    GROUP BY driver_id
),

driver_ranked AS (
    SELECT
        driver_id,
        total_driver_titles,
        DENSE_RANK() OVER (
            ORDER BY total_driver_titles DESC
        ) AS title_rank
    FROM driver_titles
)

SELECT
    fc.season,
    fc.driver_id,
    dr.total_driver_titles,
    dr.title_rank
FROM "f1_raw"."dbt_analytics"."fact_championships" fc
JOIN driver_ranked dr
    ON fc.driver_id = dr.driver_id
ORDER BY dr.title_rank, fc.season
  );
  
