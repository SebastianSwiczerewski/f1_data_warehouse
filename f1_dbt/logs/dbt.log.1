  create  table "f1_raw"."dbt_analytics"."fact_championships_enriched__dbt_tmp"
  
  
    as
  
  (
    WITH base AS (

    SELECT
        season,
        decade,
        driver_id,
        constructor_id,
        total_driver_titles,
