    FROM "f1_raw"."dbt_analytics"."dim_constructors"

)

SELECT
    b.race_id,
    b.season,
    b.race_round,

    b.driver_id,
    d.first_name || ' ' || d.last_name AS driver_name,

    b.constructor_id,
    c.constructor_name,

    b.finish_position,
    b.points,
    b.status

FROM base b
