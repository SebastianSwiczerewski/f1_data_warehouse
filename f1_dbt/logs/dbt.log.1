  create  table "f1_raw"."dbt_analytics"."fact_constructor_dynasty_enhanced__dbt_tmp"
  
  
    as
  
  (
    WITH constructor_champions AS (

    SELECT
        season,
        constructor_id
    FROM "f1_raw"."dbt_analytics"."fact_championships"

),

-- Detect consecutive streak groups
streak_base AS (

    SELECT
        constructor_id,
        season,
        season - ROW_NUMBER() OVER (
            PARTITION BY constructor_id
            ORDER BY season
        ) AS grp
    FROM constructor_champions

),

-- Aggregate streaks
streaks AS (

    SELECT
        constructor_id,
        MIN(season) AS dynasty_start,
        MAX(season) AS dynasty_end,
        COUNT(*) AS streak_length
    FROM streak_base
    GROUP BY constructor_id, grp

),

-- Keep only real dynasties (3+ consecutive titles)
filtered_dynasties AS (

    SELECT *
    FROM streaks
    WHERE streak_length >= 3

),

-- Constructor-level summary
constructor_summary AS (

    SELECT
        constructor_id,
        COUNT(*) AS number_of_dynasties,
        SUM(streak_length) AS total_dynasty_years,
        MAX(streak_length) AS longest_streak,
        MIN(dynasty_start) AS first_dynasty_start,
        MIN(dynasty_end) AS first_dynasty_end
    FROM filtered_dynasties
    GROUP BY constructor_id

)

SELECT
    constructor_id,
    number_of_dynasties,
    total_dynasty_years,
    longest_streak,
    first_dynasty_start,
    first_dynasty_end,

    -- Midpoint for X-axis
    (first_dynasty_start + first_dynasty_end) / 2.0 AS dynasty_midpoint,

    -- Bubble scaling (AGGRESSIVE)
    POWER(longest_streak, 2) * 35 AS longest_streak_scaled,

    -- Era classification
    CASE
        WHEN (first_dynasty_start + first_dynasty_end) / 2.0 < 1970 THEN 'Classic Era'
        WHEN (first_dynasty_start + first_dynasty_end) / 2.0 < 1990 THEN 'Turbo Era'
        WHEN (first_dynasty_start + first_dynasty_end) / 2.0 < 2010 THEN 'Modern Era'
        ELSE 'Hybrid Era'
    END AS era_group

FROM constructor_summary
ORDER BY dynasty_midpoint
  );
  
