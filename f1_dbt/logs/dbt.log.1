)

SELECT *
FROM titles
ORDER BY total_driver_titles DESC
  );
  
[0m16:18:39.781476 [debug] [Thread-2 (]: Using postgres connection "model.f1_dbt.fact_driver_titles_by_decade"
[0m16:18:39.781801 [debug] [Thread-3 (]: On model.f1_dbt.fact_driver_titles_ranked: /* {"app": "dbt", "dbt_version": "1.9.0", "profile_name": "f1_dbt", "target_name": "dev", "node_id": "model.f1_dbt.fact_driver_titles_ranked"} */

  
    

  create  table "f1_raw"."dbt_analytics"."fact_driver_titles_ranked__dbt_tmp"
  
  
    as
  
  (
    WITH driver_titles AS (
    SELECT
        driver_id,
        COUNT(*) AS total_driver_titles
    FROM "f1_raw"."dbt_analytics"."fact_championships"
    GROUP BY driver_id
),

driver_ranked AS (
    SELECT
        driver_id,
        total_driver_titles,
        DENSE_RANK() OVER (
            ORDER BY total_driver_titles DESC
        ) AS title_rank
    FROM driver_titles
)

SELECT
    fc.season,
    fc.driver_id,
    dr.total_driver_titles,
    dr.title_rank
FROM "f1_raw"."dbt_analytics"."fact_championships" fc
JOIN driver_ranked dr
    ON fc.driver_id = dr.driver_id
ORDER BY dr.title_rank, fc.season
  );
  
[0m16:18:39.782234 [debug] [Thread-2 (]: On model.f1_dbt.fact_driver_titles_by_decade: /* {"app": "dbt", "dbt_version": "1.9.0", "profile_name": "f1_dbt", "target_name": "dev", "node_id": "model.f1_dbt.fact_driver_titles_by_decade"} */

  
    

  create  table "f1_raw"."dbt_analytics"."fact_driver_titles_by_decade__dbt_tmp"
  
  
    as
  
  (
    WITH base AS (
    SELECT
        driver_id,
        season,
        FLOOR(season / 10) * 10 AS decade
    FROM "f1_raw"."dbt_analytics"."fact_championships"
),

titles_by_decade AS (
    SELECT
        driver_id,
        decade,
        COUNT(*) AS titles_in_decade
    FROM base
    GROUP BY driver_id, decade
),

total_titles AS (
    SELECT
        driver_id,
        COUNT(*) AS total_titles
    FROM "f1_raw"."dbt_analytics"."fact_championships"
    GROUP BY driver_id
)

SELECT
    tbd.driver_id,
    tbd.decade,
    tbd.titles_in_decade,
    tt.total_titles
FROM titles_by_decade tbd
JOIN total_titles tt
    ON tbd.driver_id = tt.driver_id
ORDER BY tt.total_titles DESC, tbd.decade
  );
  
