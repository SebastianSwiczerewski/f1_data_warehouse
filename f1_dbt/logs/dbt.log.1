[0m12:27:38.751381 [debug] [Thread-1 (]: On model.f1_dbt.fact_driver_titles_by_decade: /* {"app": "dbt", "dbt_version": "1.9.0", "profile_name": "f1_dbt", "target_name": "dev", "node_id": "model.f1_dbt.fact_driver_titles_by_decade"} */

  
    

  create  table "f1_raw"."dbt_analytics"."fact_driver_titles_by_decade__dbt_tmp"
  
  
    as
  
  (
    WITH base AS (
    SELECT
        driver_id,
        season,
        FLOOR(season / 10) * 10 AS decade
    FROM "f1_raw"."dbt_analytics"."fact_championships"
),

titles_by_decade AS (
    SELECT
        driver_id,
        decade,
        COUNT(*) AS titles_in_decade
    FROM base
    GROUP BY driver_id, decade
),

total_titles AS (
    SELECT
        driver_id,
        COUNT(*) AS total_titles
    FROM "f1_raw"."dbt_analytics"."fact_championships"
    GROUP BY driver_id
)

SELECT
    tbd.driver_id,
    tbd.decade,
    tbd.titles_in_decade,
    tt.total_titles
FROM titles_by_decade tbd
JOIN total_titles tt
    ON tbd.driver_id = tt.driver_id
ORDER BY tt.total_titles DESC, tbd.decade
  );
  
