[0m15:00:20.322343 [debug] [Thread-2 (]: On model.f1_dbt.fact_championships: /* {"app": "dbt", "dbt_version": "1.9.0", "profile_name": "f1_dbt", "target_name": "dev", "node_id": "model.f1_dbt.fact_championships"} */

  
    

  create  table "f1_raw"."dbt_analytics"."fact_championships__dbt_tmp"
  
  
    as
  
  (
    WITH driver_points AS (
    SELECT
        season,
        driver_id,
        SUM(points) AS total_points
    FROM "f1_raw"."dbt_analytics"."fact_results"
    GROUP BY season, driver_id
),

driver_ranked AS (
    SELECT
        season,
        driver_id,
        total_points,
        ROW_NUMBER() OVER (
            PARTITION BY season
            ORDER BY total_points DESC
        ) AS rnk
    FROM driver_points
),

constructor_points AS (
    SELECT
        season,
        constructor_id,
        SUM(points) AS total_points
    FROM "f1_raw"."dbt_analytics"."fact_results"
    GROUP BY season, constructor_id
),

constructor_ranked AS (
    SELECT
        season,
        constructor_id,
        total_points,
        ROW_NUMBER() OVER (
            PARTITION BY season
            ORDER BY total_points DESC
        ) AS rnk
    FROM constructor_points
)

SELECT
    d.season,
    d.driver_id,
    c.constructor_id
FROM driver_ranked d
JOIN constructor_ranked c
    ON d.season = c.season
WHERE d.rnk = 1
  AND c.rnk = 1
ORDER BY d.season;
  );
  
